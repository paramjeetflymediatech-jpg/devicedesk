{
  "name": "devicedesk-agent",
  "version": "1.0.0",
  "description": "DeviceDesk Automated Desktop Screen Activity Logger Agent",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "keywords": [
    "devicedesk",
    "screenshot",
    "activity-logger",
    "desktop-agent"
  ],
  "author": "DeviceDesk Team",
  "license": "MIT",
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.6.8",
    "electron-store": "^8.2.0",
    "screenshot-desktop": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.devicedesk.agent",
    "productName": "DeviceDeskAgent",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeviceDesk Agent",
      "artifactName": "DeviceDeskAgent-Setup.exe"
    }
  }
}
